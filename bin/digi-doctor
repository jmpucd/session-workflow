#!/usr/bin/env bash
# DESC: Check this machine's environment, deps, and config.

set -euo pipefail
source "${DIGI_LIB_DIR:?run via the digi dispatcher}/common.sh"

log "Machine:    $DIGI_HOSTNAME  (from $(digi_machine_name_source "$DIGI_ETC_DIR"))"
log "Repo:       $DIGI_REPO_DIR"
if [[ -f "$DIGI_MACHINE_CONFIG" ]]; then
  log "Overrides:  $DIGI_MACHINE_CONFIG"
else
  log "Overrides:  none (using etc/shared/defaults.yaml)"
fi

echo
log "Tool versions:"
for tool in git rsync ffmpeg exiftool yq jq rclone fzf; do
  if command -v "$tool" >/dev/null 2>&1; then
    # exiftool has no --version; it uses -ver
    if [[ "$tool" == "exiftool" ]]; then
      printf '  %-10s %s\n' "$tool" "$(exiftool -ver 2>&1 | head -1)"
    else
      printf '  %-10s %s\n' "$tool" "$("$tool" --version 2>&1 | head -1)"
    fi
  else
    printf '  %-10s \033[31mMISSING\033[0m\n' "$tool"
  fi
done

# ---- Capture One workflow paths --------------------------------------------
echo
log "Capture One workflow paths:"
check_path() {
  local label="$1" key="$2"
  local val
  val="$(machine_get "$key" 2>/dev/null || true)"
  val="${val/#\~/$HOME}"
  if [[ -z "$val" ]]; then
    printf '  %-22s \033[33m(unset)\033[0m\n' "$label"
  elif [[ ! -d "$val" && "$key" == ".paths.capture_root" ]]; then
    # Only capture machines (Versa) have this folder; everywhere else the
    # default simply doesn't exist, which is normal, not an error.
    printf '  %-22s \033[2m%s — not present (fine unless this Mac captures)\033[0m\n' "$label" "$val"
  elif [[ ! -d "$val" ]]; then
    printf '  %-22s \033[31m%s — NOT FOUND\033[0m\n' "$label" "$val"
  else
    printf '  %-22s %s\n' "$label" "$val"
  fi
}
check_path "capture_root"        ".paths.capture_root"
check_path "local_working"       ".paths.local_working"
check_path "sessions/synology"   ".sessions.synology_root"

# ---- Session format (must be UNPACKED) -------------------------------------
# Sessions must be imported unpacked; packed .eip files break the handoff.
# Scan the local session roots for stray .eip files and flag them.
echo
log "Session format (must be UNPACKED — no .eip files):"
source "${DIGI_LIB_DIR}/sessions.sh"
check_unpacked() {
  local label="$1" key="$2"
  local val
  val="$(machine_get "$key" 2>/dev/null || true)"
  val="${val/#\~/$HOME}"
  [[ -n "$val" && -d "$val" ]] || return 0
  local n
  n="$(packed_file_count "$val")"
  if [[ "$n" -gt 0 ]]; then
    printf '  %-22s \033[31m%s packed .eip file(s) found — sessions must be UNPACKED\033[0m\n' "$label" "$n"
  else
    printf '  %-22s \033[32mOK (no .eip)\033[0m\n' "$label"
  fi
}
check_unpacked "capture_root"  ".paths.capture_root"
check_unpacked "local_working" ".paths.local_working"
printf '  %s\n' "Reminder: Capture One → Preferences → Image → uncheck 'Pack as EIP'."

# ---- Synology free space ---------------------------------------------------
echo
log "Synology free space:"
if syn_root="$(machine_get .sessions.synology_root 2>/dev/null)" && [[ -d "$syn_root" ]]; then
  free_gb=$(( $(synology_free_kb) / 1024 / 1024 ))
  min_gb="$(shared_get .synology.min_free_gb)"; [[ -n "$min_gb" ]] || min_gb=50
  if (( free_gb < min_gb )); then
    printf '  \033[31m%s GB free — below the %s GB minimum; park/checkin/checkout will refuse\033[0m\n' "$free_gb" "$min_gb"
  else
    printf '  \033[32m%s GB free\033[0m\n' "$free_gb"
  fi
else
  printf '  \033[2m(Synology not mounted)\033[0m\n'
fi
echo
log "Done."
