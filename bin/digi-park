#!/usr/bin/env bash
# DESC: Push a finished Capture One session from this Mac to the Synology queue.
set -euo pipefail
source "${DIGI_LIB_DIR:?run via the digi dispatcher}/common.sh"
source "${DIGI_LIB_DIR}/sessions.sh"

require_cmd rsync yq jq

usage() {
  cat <<EOF
Usage: digi park [<session-name>]

Pushes a completed Capture One session from this machine's capture_root to
the Synology queue, then removes the local copy. Other Macs can then
'digi checkout' to work on it.

If 'digi presync' has already been staging this session's stable raw
files in the background, this only has to transfer the database and any
very recent stragglers — most of the data movement already happened
before you ran this. Either way, the session stays hidden from
queue/status/checkout until the transfer is fully verified.

Refuses to park if Capture One has the session open.

Reads:
  paths.capture_root        (this machine's config)
  sessions.synology_root    (this machine's config)
EOF
}

case "${1:-}" in -h|--help) usage; exit 0;; esac

CAPTURE_ROOT="$(capture_root)"
SYNOLOGY_ROOT="$(synology_sessions_root)"

SESSION="${1:-}"
if [[ -z "$SESSION" ]]; then
  SESSION="$(session_pick "$CAPTURE_ROOT" "Pick a session to park")"
fi

SRC="${CAPTURE_ROOT}/${SESSION}"
DST="${SYNOLOGY_ROOT}/${SESSION}"

[[ -d "$SRC" ]] || die "No such session: $SRC"

assert_capture_one_idle "$SRC"
assert_session_unpacked "$SRC"

if [[ -e "$DST" ]] && ! notready_exists "$SESSION"; then
  warn "$DST already exists on Synology and isn't mid-presync — this will sync in place (no overwrite of newer files on Synology)."
  confirm "Continue?" || die "Aborted."
fi

USER_NAME="$(who_am_i)"

log "Parking $SESSION"
log "  from: $SRC ($(session_size_pretty "$SRC"))"
log "  to:   $DST"

mkdir -p "$DST"
# Mark not-ready before transferring (harmless no-op if digi-presync already
# has). This is what keeps the session hidden from queue/status/checkout for
# the whole transfer, not just "directory happens to exist yet".
notready_write "$SESSION" "park"

rsync_args
rsync "${RSYNC_ARGS[@]}" "$SRC/" "$DST/"

# Sanity check: destination has files
if [[ -z "$(ls -A "$DST" 2>/dev/null)" ]]; then
  die "rsync finished but $DST is empty — refusing to remove local copy. Not clearing the not-ready marker either; investigate before retrying."
fi

# This is the real "officially parked" moment — only now is it visible.
notready_clear "$SESSION"

log "Removing local copy: $SRC"
rm -rf "$SRC"

log_event park "$SESSION" "$USER_NAME"

log "✓ Parked. Session is now in the queue. Anyone can 'digi checkout' to work on it."
